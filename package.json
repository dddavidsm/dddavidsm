{
  "name": "david-sanchez-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test tests/portfolio.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts --project=chromium",
    "test:links": "playwright test tests/links.spec.ts --project=chromium",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
